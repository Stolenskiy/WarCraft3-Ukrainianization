#!/bin/sh
# Увімкнути: make hooks (git config core.hooksPath .githooks). Обхід — лише git commit --no-verify.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
"$PY" -I tools/guard_no_audio.py
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)
if [ -n "$staged" ] && [ -x .venv/bin/ruff ]; then
  # shellcheck disable=SC2086
  .venv/bin/ruff check $staged
fi
